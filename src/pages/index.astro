---
import { content } from "../content";

const { brand, meta, hero, about, services, contact } = content;
const canonical = new URL("/", Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="wrap masthead">
      <picture>
        <source srcset="/logo-on-dark.webp" media="(prefers-color-scheme: dark)" />
        <img class="logo" src="/logo-on-light.webp" alt={brand} width="825" height="96" />
      </picture>
    </header>

    <main class="wrap">
      <section class="hero">
        <p class="role">{hero.role}</p>
        <h1>{hero.headline}</h1>
        <p class="intro">{hero.intro}</p>
      </section>

      <section class="row">
        <h2>{about.heading}</h2>
        <p class="body">{about.body}</p>
      </section>

      <section class="row">
        <h2>{services.heading}</h2>
        <ul class="services">
          {
            services.items.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="row">
        <h2>{contact.heading}</h2>
        <div>
          <p class="body">{contact.text}</p>
          <p><a class="cta" href={contact.href}>{contact.linkLabel} <span aria-hidden="true">→</span></a></p>
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <small>© {year} {brand}</small>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf8f4;
    --text: #1c1a17;
    --muted: #5f5a52;
    --rule: #ddd8ce;
    --accent: #a83a0c;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141311;
      --text: #f2efe9;
      --muted: #a9a398;
      --rule: #34312b;
      --accent: #f4905c;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .wrap {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
  }

  .masthead {
    padding-block: 1.75rem;
  }

  .logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 2rem;
  }

  .hero {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(3rem, 8vw, 5.5rem);
  }

  .role {
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 8vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .intro {
    max-width: 38ch;
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: clamp(1.15rem, 2.4vw, 1.375rem);
    line-height: 1.45;
  }

  .row {
    display: grid;
    gap: 1rem 2.5rem;
    padding-block: clamp(2rem, 5vw, 3.25rem);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 44rem) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
  }

  .body {
    max-width: 58ch;
  }

  .services {
    display: grid;
    gap: 1.75rem;
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }

  .services p {
    max-width: 52ch;
    color: var(--muted);
  }

  .cta {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
  }

  .footer {
    padding-block: 2rem 2.5rem;
    color: var(--muted);
  }
</style>
